# Sagar PG AI Manager -- configuration template.
#
# Copy this file to `.env` and fill in the values. `.env` is git-ignored; this
# template is tracked on purpose, so it lists which settings exist without
# carrying a single real value. A test enforces that every secret key below is
# left blank here.
#
#   cp .env.example .env
#   chmod 600 .env
#
# Never commit a filled-in `.env`.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Only used when the app runs outside Docker. Inside the compose stack the
# DATABASE_URL is built from the POSTGRES_* values below.
DATABASE_URL=postgresql://sagar:devpass@localhost:5432/sagarpg
POSTGRES_USER=sagar
POSTGRES_DB=sagarpg
POSTGRES_PASSWORD=

# ---------------------------------------------------------------------------
# WhatsApp channel (Meta Cloud API)
# ---------------------------------------------------------------------------
# meta_cloud (official) or peach (a BSP). The default is meta_cloud.
CHANNEL_PROVIDER=meta_cloud
META_APP_SECRET=
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_VERIFY_TOKEN=
META_WABA_ID=
META_BUSINESS_ACCOUNT_ID=

# ---------------------------------------------------------------------------
# Owner and staff
# ---------------------------------------------------------------------------
# The owner's WhatsApp number in E.164 (leading +). Only this number can
# approve, reject, check in or manage bookings.
OWNER_PHONE=
# Comma-separated staff numbers. Staff are read-only: they can ask questions
# but cannot create or manage bookings.
STAFF_PHONES=

# ---------------------------------------------------------------------------
# WhatsApp Flows (interactive booking calendar)
# ---------------------------------------------------------------------------
# The published Flow id and the screen it opens for the check-in / check-out
# calendar. Both must be set to send the Flow; leave either blank to fall back
# to quick-reply date buttons. The guest's answers arrive back on the webhook.
WHATSAPP_FLOW_ID=
WHATSAPP_FLOW_CALENDAR_SCREEN=

# ---------------------------------------------------------------------------
# AI (optional -- without a key, replies are plain but still correct)
# ---------------------------------------------------------------------------
AI_PROVIDER=gemini
AI_MODEL=gemini-flash-lite-latest
AI_API_KEY=
AI_BASE_URL=
AI_TIMEOUT=90

# ---------------------------------------------------------------------------
# Hostel behaviour
# ---------------------------------------------------------------------------
HOSTEL_TIMEZONE=Asia/Kolkata
# A temporary pause on outbound guest replies. The owner can also toggle this
# from WhatsApp. Bookings and messages are still recorded while paused.
AUTO_REPLY_ENABLED=true
# Where a guest's payment screenshot is filed. Private, never in the database.
PAYMENT_PROOF_DIR=payment_proofs

# ---------------------------------------------------------------------------
# Dashboard
# ---------------------------------------------------------------------------
# Read-only owner dashboard at /dashboard. With this unset a random password is
# generated for the run and logged, so a public deployment never opens the
# guest table to a guessable password.
DASHBOARD_PASSWORD=

# ---------------------------------------------------------------------------
# Scheduler and jobs
# ---------------------------------------------------------------------------
JOB_TOKEN=
SAGAR_APP_URL=http://127.0.0.1:12000
SCHEDULER_INTERVAL=60
# Blank uses the built-in default; set it to keep the run history elsewhere.
SCHEDULER_STATE_FILE=
# Outbound sending is opt-in until production is explicitly activated.
OUTBOUND_SCHEDULER_ENABLED=

# ---------------------------------------------------------------------------
# Owner email copies (optional)
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
OWNER_EMAIL=

# ---------------------------------------------------------------------------
# Caddy / TLS
# ---------------------------------------------------------------------------
SAGAR_HOST=

# ---------------------------------------------------------------------------
# Watchdog (optional recovery loop)
# ---------------------------------------------------------------------------
WATCHDOG_INTERVAL=
WATCHDOG_TIMEOUT=
WATCHDOG_STATE_DIR=
LOG_LEVEL=
PORT=
