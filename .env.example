# Copy to .env and fill in. Never commit .env.

# --- Database -------------------------------------------------------------
DATABASE_URL=postgresql://sagar:devpass@localhost:5432/sagarpg
HOSTEL_TIMEZONE=Asia/Kolkata

# --- WhatsApp channel -----------------------------------------------------
# meta_cloud (default) or peach
CHANNEL_PROVIDER=meta_cloud

# Meta WhatsApp Cloud API (only when CHANNEL_PROVIDER=meta_cloud)
META_APP_SECRET=
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_VERIFY_TOKEN=
# Optional. The WhatsApp Business Account id (the "Messaging account ID").
# Not read by the app; used only by scripts/check_meta.py to list the phone
# numbers on the account and confirm which phone number ID is the right one.
META_BUSINESS_ACCOUNT_ID=

# Peach (only if CHANNEL_PROVIDER=peach)
PEACH_API_KEY=
PEACH_PHONE_NUMBER_ID=

# --- Owner ----------------------------------------------------------------
# Owner WhatsApp number in E.164. Owner commands are only honoured from here.
OWNER_PHONE=

# --- Dashboard ------------------------------------------------------------
# Password for the owner's dashboard at /dashboard. When unset, the app
# generates a random one and prints it to the log on every start, so a restart
# logs you out. Set it to keep a stable password.
DASHBOARD_PASSWORD=

# --- AI -------------------------------------------------------------------
# The provider and model are a configuration choice, not a code change.
#   gemini            Google Gemini, cheapest sensible default (free tier available)
#   openai            OpenAI
#   openrouter        OpenRouter, many models behind one key
#   groq              Groq, very low cost, fast
#   ollama            a model running locally on your own machine, no API cost
AI_PROVIDER=gemini
AI_MODEL=gemini-flash-lite-latest
AI_API_KEY=
# Only for OpenAI-compatible providers that are not OpenAI itself.
# For a local model: http://localhost:11434/v1
AI_BASE_URL=
# Seconds to wait for one model call. Thinking models can take a while.
AI_TIMEOUT=90

# --- Auto-reply pause -----------------------------------------------------
# The DEFAULT for automatic replies to guests. true = answer as normal.
#
# This is only the starting value. The owner can pause and resume at any time
# from the dashboard (a Pause/Resume button) or by texting the hostel number
# ("pause replies" / "resume replies"), and that choice is stored in the
# database and survives restarts. Set this to false only to start up paused.
#
# While paused: messages are still received and saved, bookings, availability
# and payments keep working, and the owner is still told about new booking
# requests. Only the automatic reply to the guest stops. The webhook and the
# Meta connection stay up. See docs/OPERATIONS.md.
AUTO_REPLY_ENABLED=true

# --- Scheduled jobs -------------------------------------------------------
# Shared secret for the /jobs endpoints that the scheduler calls. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JOB_TOKEN=

# Where the scheduler reaches the app. Local runs use the default; the lite
# compose file sets http://app:8000 itself.
SAGAR_APP_URL=http://127.0.0.1:12000
# Seconds between the scheduler's checks for a due job.
SCHEDULER_INTERVAL=60

# --- Deployment only ------------------------------------------------------
# Needed by deploy/docker-compose.yml and deploy/docker-compose.lite.yml.
# Ignore these when running locally.
POSTGRES_USER=sagar
POSTGRES_PASSWORD=
POSTGRES_DB=sagarpg

# Your domain, without https://. Caddy uses it to get the HTTPS certificate.
# For the lean setup (docker-compose.lite.yml) only SAGAR_HOST is needed.
SAGAR_HOST=

# Only for the n8n setup (docker-compose.yml). Ignore for docker-compose.lite.yml.
N8N_HOST=
N8N_USER=owner
N8N_PASSWORD=
# Encrypts the credentials n8n stores. Generate once, then never change it or
# n8n will not be able to read its own stored credentials:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
N8N_ENCRYPTION_KEY=
